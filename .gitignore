*.p8
*.jsonl
!scripts/fixtures/codex-sessions/**/rollout-replay-synthetic.jsonl
.tmp/
.private/
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# macOS
.DS_Store

# Editor
.vscode/*
