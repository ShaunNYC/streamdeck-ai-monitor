# Node
node_modules
npm-debug.log*

# Build output
dist/
out/
*.tsbuildinfo

# Electron release output and generated platform icon
packages/app/out/
packages/app/build-native/
packages/app/assets/app-icon.icns
release/macos-*/
release/mas-*/

